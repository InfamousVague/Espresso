<?xml version="1.0" encoding="UTF-8"?>
<!--
  Espresso host entitlements. Just the App Group so the host can
  write SharedStats into the Group Container that the
  EspressoWidgets extension reads. NOT sandboxed: the keep-awake
  engine uses IOPMAssertionCreate + CGEvent posting (mouse jiggle)
  + privileged clamshell rules — all incompatible with App Sandbox.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.espresso</string>
  </array>
</dict>
</plist>
